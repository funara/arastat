{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARAStat",
  "version": "0.1.0",
  "identifier": "com.funara.arastat",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ARAStat",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "maximized": true,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine/ara_engine": "engine/ara_engine",
      "../engine/.venv": "engine/.venv",
      "../engine/pyproject.toml": "engine/pyproject.toml",
      "../engine/requirements.txt": "engine/requirements.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2RkNFQTNDRDM0QzIxODcKUldTSElVelRQT3I4Qm5TeGJ4SFZlaXR4NlA3YlBlQjVCSVEzbU52bkZwbkhZR01sRTVyOHR4eWgK",
      "endpoints": ["https://github.com/funara/arastat/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
